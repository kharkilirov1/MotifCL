// Row softmax with max-subtraction, one wave64 workgroup per row.
// Subgroup reduction variant: replaces shared-memory tree (5 barriers +
// 5 LDS round-trips per reduction) with subgroupAdd / subgroupBroadcast.
// Dispatched only when caps.subgroup_arithmetic_compute is true.
#version 450

#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer XBuf { float x[]; };
layout(std430, set = 0, binding = 1) writeonly buffer OutBuf { float outv[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint cols;
} p;

void main() {
    const uint row = gl_WorkGroupID.x;
    const uint lane = gl_LocalInvocationID.x;
    if (row >= p.rows) return;
    const uint base = row * p.cols;

    // Pass 1: per-lane max, then subgroup-wide max (one wave64 = one subgroup).
    float maxv = -3.402823466e+38;
    for (uint c = lane; c < p.cols; c += 64u) {
        maxv = max(maxv, x[base + c]);
    }
    maxv = subgroupMax(maxv);

    // Pass 2: per-lane sum of exp, then subgroup sum.
    float sum = 0.0;
    for (uint c = lane; c < p.cols; c += 64u) {
        sum += exp(x[base + c] - maxv);
    }
    sum = subgroupAdd(sum);
    const float inv_sum = 1.0 / sum;

    // Pass 3: normalize (recompute exp; cheaper than cross-lane storage).
    for (uint c = lane; c < p.cols; c += 64u) {
        outv[base + c] = exp(x[base + c] - maxv) * inv_sum;
    }
}
