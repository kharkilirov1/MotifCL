// Exact state-only update for a counter layer whose gradient is identically
// zero (a MoE expert that lost the router's argmax).
//
// In counter_update_apply_f32.comp, with grad_w == 0 every derived quantity
// collapses: g_sq == 0 and grad_s == 0, so
//   * the tick is -lr * (0 / dn) * (C / s_new) == 0  -> packed state bytes and
//     the row scale s_new = clamp(s_old - lr_scale * 0) = s_old are unchanged,
//   * but the row second moment still moves: v_new = beta * v + (1-beta) * 0.
//
// So the dense backward pass does change a losing expert's v on every step, and
// a sparse backward that simply skipped the expert would drift from it. This
// kernel reproduces that one surviving term for the whole layer: O(out_features)
// work instead of the grad_w GEMM plus the per-group tick.
//
// beta * v + (1 - beta) * 0 is beta * v for every finite beta, and v is a sum of
// squares, so the product here matches the general kernel bit for bit.
#version 450

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer VBuf { float v[]; };

layout(push_constant) uniform Push {
    uint rows;
    float beta;
} p;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= p.rows) return;
    v[i] = p.beta * v[i];
}
