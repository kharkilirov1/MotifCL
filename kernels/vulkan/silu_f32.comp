// SiLU forward: y = x * sigmoid(x).
#version 450
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer XBuf { float x[]; };
layout(std430, set = 0, binding = 1) writeonly buffer OutBuf { float outv[]; };
layout(push_constant) uniform Push { uint n; } p;
void main() {
    const uint gid = gl_GlobalInvocationID.x;
    if (gid >= p.n) return;
    const float v = x[gid];
    const float s = 1.0 / (1.0 + exp(-v));
    outv[gid] = v * s;
}
