// C[M,N] = A[K,M]^T * B[K,N], row-major F32 (transpose-A matmul).
// 16x16 shared-memory tile per workgroup; the dB = A^T * dC backward form.
#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer ABuf { float A[]; };
layout(std430, set = 0, binding = 1) readonly buffer BBuf { float B[]; };
layout(std430, set = 0, binding = 2) writeonly buffer CBuf { float C[]; };

layout(push_constant) uniform Push {
    uint M;
    uint K;
    uint N;
} p;

shared float As[16][17];
shared float Bs[16][17];

void main() {
    const uint tx = gl_LocalInvocationID.x;
    const uint ty = gl_LocalInvocationID.y;
    const uint col = gl_WorkGroupID.x * 16u + tx;  // n
    const uint row = gl_WorkGroupID.y * 16u + ty;  // m

    float acc = 0.0;
    const uint tiles = (p.K + 15u) / 16u;
    for (uint t = 0u; t < tiles; ++t) {
        const uint k = t * 16u + ty;
        const uint a_col = gl_WorkGroupID.y * 16u + tx;  // m index for the A tile
        As[ty][tx] = (k < p.K && a_col < p.M) ? A[k * p.M + a_col] : 0.0;
        Bs[ty][tx] = (k < p.K && col < p.N) ? B[k * p.N + col] : 0.0;
        barrier();
        for (uint i = 0u; i < 16u; ++i) {
            acc += As[i][ty] * Bs[i][tx];
        }
        barrier();
    }
    if (row < p.M && col < p.N) {
        C[row * p.N + col] = acc;
    }
}
