// Sparse (list-driven) variant of counter_gemm_db.comp for the MoE experts.
//
// Same 32x32 one-wave tile, 4x4 per lane, 16-deep K ring and 128-bit LDS
// operands as counter_gemm_db.comp -- only the row addressing changes, so the
// decode arithmetic and the accumulation order per output element are
// identical to the dense kernel. That is what makes the sparse path
// numerically comparable to the dense path instead of merely "close".
//
// Two forward modes:
//   mode 0 (expert up-projection):  A is the [tokens, in] activation, rows are
//       gathered through list[expert*capacity + m]; C is compact [capacity, out].
//   mode 2 (expert down-projection): A is the compact [capacity, in] SwiGLU
//       output (row m), C is scattered back to y[list[expert*capacity + m], out].
//
// `counts[expert]` bounds the live rows. Workgroups whose row tile starts at or
// beyond the count exit immediately, so a dispatch sized for the worst case
// (`capacity` rows) costs the live workgroups only -- no token dropping, no
// capacity factor, no host read-back of the routing decision.
#version 450
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, set = 0, binding = 0) readonly buffer ABuf { vec4 A4[]; };
layout(std430, set = 0, binding = 1) readonly buffer StateBuf { uint8_t state[]; };
layout(std430, set = 0, binding = 2) readonly buffer ScaleBuf { float scale[]; };
layout(std430, set = 0, binding = 3) writeonly buffer CBuf { float c_out[]; };
layout(std430, set = 0, binding = 4) readonly buffer IdxBuf { uint idx[]; };
layout(std430, set = 0, binding = 5) readonly buffer CountBuf { uint counts[]; };

layout(push_constant) uniform Push {
    uint C;
    uint in_features;
    uint out_features;
    uint capacity;
    uint expert;
    uint mode; // 0 = up (gather A, compact C), 2 = down (compact A, scatter C)
} p;

#define RB 32
#define KT 16
#define LANES 64
#define NQ (RB / 4)
#define ITEMS (RB * KT / 4)
#define PER_LANE (ITEMS / LANES)

shared vec4 As[2][KT][NQ];
shared vec4 Ws[2][KT][NQ];
shared int tlut[64];
shared uint s_rows;

int levels_of(uint C) {
    return int(2u * C - 1u);
}

int ternary_from_code(int code, int levels) {
    if (code < levels) return -1;
    if (code < 2 * levels) return 0;
    if (code < 3 * levels) return 1;
    return code / levels - 1;
}

// ---- activation staging (A) ------------------------------------------------
// mode 0: source row = list[expert*capacity + gm]  (gather on load)
// mode 2: source row = gm                          (compact, contiguous)

void load_a(uint lid, uint m0, uint kt, uint K, out vec4 r0, out vec4 r1) {
    const uint rows = s_rows;
    for (int i = 0; i < PER_LANE; ++i) {
        const uint j = lid + uint(i) * uint(LANES);
        const uint r = j >> 2;
        const uint kq = j & 3u;
        const uint gm = m0 + r;
        const uint gk = kt + kq * 4u;
        vec4 v = vec4(0.0);
        if (gm < rows && gk < K) {
            const uint src = (p.mode == 0u) ? idx[p.expert * p.capacity + gm] : gm;
            v = A4[(src * K + gk) >> 2];
        }
        if (i == 0) r0 = v; else r1 = v;
    }
}

void store_a(int buf, uint lid, vec4 r0, vec4 r1) {
    for (int i = 0; i < PER_LANE; ++i) {
        const vec4 v = (i == 0) ? r0 : r1;
        const uint j = lid + uint(i) * uint(LANES);
        const uint r = j >> 2;
        const uint kq = j & 3u;
        const uint q = r >> 2;
        const uint e = r & 3u;
        As[buf][kq * 4u + 0u][q][e] = v.x;
        As[buf][kq * 4u + 1u][q][e] = v.y;
        As[buf][kq * 4u + 2u][q][e] = v.z;
        As[buf][kq * 4u + 3u][q][e] = v.w;
    }
}

// ---- weight decode (B) -----------------------------------------------------

void load_b(uint lid, uint n0, uint kt, uint K, out vec4 r0, out vec4 r1) {
    const uint groups_per_row = p.in_features / 4u;
    const int levels = levels_of(p.C);
    for (int i = 0; i < PER_LANE; ++i) {
        const uint j = lid + uint(i) * uint(LANES);
        vec4 w = vec4(0.0);
        if (p.mode != 1u) {
            const uint c = j >> 2;
            const uint kg = j & 3u;
            const uint gc = n0 + c;
            const uint gk = kt + kg * 4u;
            if (gc < p.out_features && gk < p.in_features) {
                const uint base = (gc * groups_per_row + (gk >> 2)) * 3u;
                const int b0 = int(uint(state[base]));
                const int b1 = int(uint(state[base + 1u]));
                const int b2 = int(uint(state[base + 2u]));
                const float s = scale[gc];
                w.x = s * float(tlut[b0 & 0x3F]);
                w.y = s * float(tlut[((b0 >> 6) | (b1 << 2)) & 0x3F]);
                w.z = s * float(tlut[((b1 >> 4) | (b2 << 4)) & 0x3F]);
                w.w = s * float(tlut[(b2 >> 2) & 0x3F]);
            }
        } else {
            const uint kr = j >> 3;
            const uint cg = j & 7u;
            const uint gk = kt + kr;
            const uint gc = n0 + cg * 4u;
            if (gk < p.out_features && gc < p.in_features) {
                const uint base = (gk * groups_per_row + (gc >> 2)) * 3u;
                const int b0 = int(uint(state[base]));
                const int b1 = int(uint(state[base + 1u]));
                const int b2 = int(uint(state[base + 2u]));
                const float s = scale[gk];
                w.x = s * float(tlut[b0 & 0x3F]);
                w.y = s * float(tlut[((b0 >> 6) | (b1 << 2)) & 0x3F]);
                w.z = s * float(tlut[((b1 >> 4) | (b2 << 4)) & 0x3F]);
                w.w = s * float(tlut[(b2 >> 2) & 0x3F]);
            }
        }
        if (i == 0) r0 = w; else r1 = w;
    }
}

void store_b(int buf, uint lid, vec4 r0, vec4 r1) {
    for (int i = 0; i < PER_LANE; ++i) {
        const vec4 w = (i == 0) ? r0 : r1;
        const uint j = lid + uint(i) * uint(LANES);
        if (p.mode != 1u) {
            const uint c = j >> 2;
            const uint kg = j & 3u;
            const uint q = c >> 2;
            const uint e = c & 3u;
            Ws[buf][kg * 4u + 0u][q][e] = w.x;
            Ws[buf][kg * 4u + 1u][q][e] = w.y;
            Ws[buf][kg * 4u + 2u][q][e] = w.z;
            Ws[buf][kg * 4u + 3u][q][e] = w.w;
        } else {
            const uint kr = j >> 3;
            const uint cg = j & 7u;
            Ws[buf][kr][cg] = w;
        }
    }
}

// ---- epilogue --------------------------------------------------------------
// mode 0: compact destination row (m0 + r)
// mode 2: scattered destination row list[expert*capacity + (m0 + r)]

void emit(uint row, uint col, uint N, float value) {
    if (col >= N) return;
    uint dst = row;
    if (p.mode == 2u) dst = idx[p.expert * p.capacity + row];
    c_out[dst * N + col] = value;
}

void main() {
    const uint lcol = uint(gl_LocalInvocationID.x);
    const uint lrow = uint(gl_LocalInvocationID.y);
    const uint lid = lrow * 8u + lcol;
    const uint n0 = uint(gl_WorkGroupID.x) * uint(RB);
    const uint m0 = uint(gl_WorkGroupID.y) * uint(RB);

    if (lid == 0u) s_rows = min(counts[p.expert], p.capacity);
    barrier();
    if (m0 >= s_rows) return;

    // Both implemented modes are forward projections (contract over in_features,
    // emit out_features); they differ only in where A rows come from and where C
    // rows go. Mode 1 (backward_input) is reserved and not emitted here.
    const uint K = p.in_features;
    const uint N = p.out_features;
    const uint ktiles = (K + uint(KT) - 1u) / uint(KT);

    if (lid < 64u) tlut[lid] = ternary_from_code(int(lid), levels_of(p.C));
    barrier();

    vec4 ra0 = vec4(0.0);
    vec4 ra1 = vec4(0.0);
    vec4 rb0 = vec4(0.0);
    vec4 rb1 = vec4(0.0);

    load_a(lid, m0, 0u, K, ra0, ra1);
    load_b(lid, n0, 0u, K, rb0, rb1);
    store_a(0, lid, ra0, ra1);
    store_b(0, lid, rb0, rb1);
    barrier();

    vec4 acc0 = vec4(0.0);
    vec4 acc1 = vec4(0.0);
    vec4 acc2 = vec4(0.0);
    vec4 acc3 = vec4(0.0);
    uint cur = 0u;
    for (uint t = 0u; t < ktiles; ++t) {
        const bool has_next = (t + 1u) < ktiles;
        if (has_next) {
            load_a(lid, m0, (t + 1u) * uint(KT), K, ra0, ra1);
            load_b(lid, n0, (t + 1u) * uint(KT), K, rb0, rb1);
        }
        for (int kk = 0; kk < KT; ++kk) {
            const vec4 a = As[cur][kk][lrow];
            const vec4 b = Ws[cur][kk][lcol];
            acc0 += a.x * b;
            acc1 += a.y * b;
            acc2 += a.z * b;
            acc3 += a.w * b;
        }
        if (has_next) {
            store_a(int(cur ^ 1u), lid, ra0, ra1);
            store_b(int(cur ^ 1u), lid, rb0, rb1);
        }
        barrier();
        cur ^= 1u;
    }

    const uint rows = s_rows;
    const uint row0 = m0 + lrow * 4u;
    const uint col0 = n0 + lcol * 4u;
    if (row0 + 0u < rows) { emit(row0 + 0u, col0 + 0u, N, acc0.x); emit(row0 + 0u, col0 + 1u, N, acc0.y); emit(row0 + 0u, col0 + 2u, N, acc0.z); emit(row0 + 0u, col0 + 3u, N, acc0.w); }
    if (row0 + 1u < rows) { emit(row0 + 1u, col0 + 0u, N, acc1.x); emit(row0 + 1u, col0 + 1u, N, acc1.y); emit(row0 + 1u, col0 + 2u, N, acc1.z); emit(row0 + 1u, col0 + 3u, N, acc1.w); }
    if (row0 + 2u < rows) { emit(row0 + 2u, col0 + 0u, N, acc2.x); emit(row0 + 2u, col0 + 1u, N, acc2.y); emit(row0 + 2u, col0 + 2u, N, acc2.z); emit(row0 + 2u, col0 + 3u, N, acc2.w); }
    if (row0 + 3u < rows) { emit(row0 + 3u, col0 + 0u, N, acc3.x); emit(row0 + 3u, col0 + 1u, N, acc3.y); emit(row0 + 3u, col0 + 2u, N, acc3.z); emit(row0 + 3u, col0 + 3u, N, acc3.w); }
}
