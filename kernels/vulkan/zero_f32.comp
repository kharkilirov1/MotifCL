// Zero-fill: out[i] = 0. Used to pre-zero the grad_weight buffer before the
// atomic-scatter embedding weight backward accumulates into it.
#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) buffer OutBuf { float outv[]; };

layout(push_constant) uniform Push {
    uint n;
} p;

void main() {
    const uint gid = gl_GlobalInvocationID.x;
    if (gid >= p.n) return;
    outv[gid] = 0.0;
}
