// out[0] = sum(partial[0..count)) / denominator, one wave64 workgroup.
// Subgroup reduction variant.
#version 450

#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer PartialBuf { float partial_in[]; };
layout(std430, set = 0, binding = 1) writeonly buffer OutBuf { float outv[]; };

layout(push_constant) uniform Push {
    uint count;
    uint denominator;
} p;

void main() {
    const uint lane = gl_LocalInvocationID.x;
    float acc = 0.0;
    for (uint i = lane; i < p.count; i += 64u) {
        acc += partial_in[i];
    }
    acc = subgroupAdd(acc);
    if (lane == 0u) {
        outv[0] = p.denominator > 0u ? acc / float(p.denominator) : 0.0;
    }
}
