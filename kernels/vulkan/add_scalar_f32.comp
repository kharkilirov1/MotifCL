// Elementwise scalar add: out = x + value (1 element per lane, coalesced).
// Used by `add_scalar` op on Vulkan. Mirrors kernels/basic.cl:add_scalar_f32.
#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer XBuf { float x[]; };
layout(std430, set = 0, binding = 1) writeonly buffer OBuf { float outv[]; };

layout(push_constant) uniform Push {
    float value;
    uint n;
} p;

void main() {
    const uint gid = gl_GlobalInvocationID.x;
    if (gid >= p.n) return;
    outv[gid] = x[gid] + p.value;
}
