// Sigmoid backward using saved output y: dx = dy * y * (1-y).
#version 450
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer YBuf { float y[]; };
layout(std430, set = 0, binding = 1) readonly buffer DyBuf { float dy[]; };
layout(std430, set = 0, binding = 2) writeonly buffer DxBuf { float dx[]; };
layout(push_constant) uniform Push { uint n; } p;
void main() {
    const uint gid = gl_GlobalInvocationID.x;
    if (gid >= p.n) return;
    const float v = y[gid];
    dx[gid] = dy[gid] * v * (1.0 - v);
}
