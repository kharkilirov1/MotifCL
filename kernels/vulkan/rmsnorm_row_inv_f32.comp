// Per-row inverse RMS: row_inv[r] = rsqrt(mean(x[r]^2) + eps).
// Stage 1 of the RMSNorm weight-gradient (one wave64 workgroup per row).
#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer XBuf { float x[]; };
layout(std430, set = 0, binding = 1) writeonly buffer InvBuf { float row_inv[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint cols;
    float eps;
} p;

shared float scratch[64];

void main() {
    const uint row = gl_WorkGroupID.x;
    const uint lane = gl_LocalInvocationID.x;
    if (row >= p.rows) return;
    const uint base = row * p.cols;

    float ss = 0.0;
    for (uint c = lane; c < p.cols; c += 64u) {
        const float v = x[base + c];
        ss += v * v;
    }
    scratch[lane] = ss;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (lane < stride) scratch[lane] += scratch[lane + stride];
        barrier();
    }
    if (lane == 0u) {
        row_inv[row] = inversesqrt(scratch[0] / float(p.cols) + p.eps);
    }
}
