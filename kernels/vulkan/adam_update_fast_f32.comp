// Fused AdamW update, one invocation per element. Bias corrections c1/c2 are
// precomputed on the host (c1 = 1/(1-beta1^t), c2 = 1/(1-beta2^t)). Decoupled
// weight decay is applied AdamW-style. param/m/v update in place.
#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) buffer ParamBuf { float param[]; };
layout(std430, set = 0, binding = 1) readonly buffer GradBuf { float grad[]; };
layout(std430, set = 0, binding = 2) buffer MBuf { float m[]; };
layout(std430, set = 0, binding = 3) buffer VBuf { float v[]; };

layout(push_constant) uniform Push {
    uint n;
    float lr;
    float beta1;
    float beta2;
    float eps;
    float weight_decay;
    float c1;
    float c2;
} p;

void main() {
    const uint gid = gl_GlobalInvocationID.x;
    if (gid >= p.n) return;
    const float g = grad[gid];
    const float mn = p.beta1 * m[gid] + (1.0 - p.beta1) * g;
    const float vn = p.beta2 * v[gid] + (1.0 - p.beta2) * g * g;
    m[gid] = mn;
    v[gid] = vn;
    const float mhat = mn * p.c1;
    const float vhat = vn * p.c2;
    param[gid] -= p.lr * (mhat / (sqrt(vhat) + p.eps) + p.weight_decay * param[gid]);
}
