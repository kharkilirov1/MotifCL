// Backward for normalized FOG BLOCK_PRODUCT.
// Recomputes raw complex product z and applies normalized-vector derivative.
#version 450
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer ValueBuf { float value[]; };
layout(std430, set = 0, binding = 1) readonly buffer ReadBuf { float readv[]; };
layout(std430, set = 0, binding = 2) readonly buffer DyBuf { float dy[]; };
layout(std430, set = 0, binding = 3) writeonly buffer DValueBuf { float dvalue[]; };
layout(std430, set = 0, binding = 4) writeonly buffer DReadBuf { float dread[]; };
layout(push_constant) uniform Push { uint rows; uint d_model; } p;
shared float ss_scratch[64];
shared float dot_scratch[64];
void main() {
    const uint row = gl_WorkGroupID.x;
    const uint lid = gl_LocalInvocationID.x;
    if (row >= p.rows) return;
    const uint base = row * p.d_model;
    float ss = 0.0;
    float dotzy = 0.0;
    for (uint j = lid * 2u; j + 1u < p.d_model; j += 128u) {
        const float vr = value[base + j];
        const float vi = value[base + j + 1u];
        const float rr = readv[base + j];
        const float ri = readv[base + j + 1u];
        const float zr = vr * rr - vi * ri;
        const float zi = vr * ri + vi * rr;
        ss += zr * zr + zi * zi;
        dotzy += zr * dy[base + j] + zi * dy[base + j + 1u];
    }
    ss_scratch[lid] = ss;
    dot_scratch[lid] = dotzy;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (lid < stride) {
            ss_scratch[lid] += ss_scratch[lid + stride];
            dot_scratch[lid] += dot_scratch[lid + stride];
        }
        barrier();
    }
    const float norm2 = max(ss_scratch[0], 1.0e-20);
    const float scale = sqrt(float(p.d_model)) * inversesqrt(norm2);
    const float corr = dot_scratch[0] / norm2;
    for (uint j = lid * 2u; j + 1u < p.d_model; j += 128u) {
        const float vr = value[base + j];
        const float vi = value[base + j + 1u];
        const float rr = readv[base + j];
        const float ri = readv[base + j + 1u];
        const float zr = vr * rr - vi * ri;
        const float zi = vr * ri + vi * rr;
        const float gzr = scale * (dy[base + j] - zr * corr);
        const float gzi = scale * (dy[base + j + 1u] - zi * corr);
        // z = v * r in complex arithmetic.
        dvalue[base + j]      = gzr * rr + gzi * ri;
        dvalue[base + j + 1u] = -gzr * ri + gzi * rr;
        dread[base + j]       = gzr * vr + gzi * vi;
        dread[base + j + 1u]  = -gzr * vi + gzi * vr;
    }
}
