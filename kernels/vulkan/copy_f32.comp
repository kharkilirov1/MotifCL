// out[i] = in[i]; used to commit per-row scale updates after the counter tick.
#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer InBuf { float src[]; };
layout(std430, set = 0, binding = 1) writeonly buffer OutBuf { float dst[]; };

layout(push_constant) uniform Push {
    uint n;
} p;

void main() {
    const uint gid = gl_GlobalInvocationID.x;
    if (gid >= p.n) return;
    dst[gid] = src[gid];
}
