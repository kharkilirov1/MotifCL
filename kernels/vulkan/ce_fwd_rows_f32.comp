// Softmax cross-entropy per-row losses, matching kernels/loss.cl
// softmax_cross_entropy_partial_f32_i32:
//   partial[row] = logsumexp(logits[row]) - logits[row, target[row]]
//   (0 when target is out of range).
// One wave64 workgroup per row with shared-memory max/sum reductions.
#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer LogitsBuf { float logits[]; };
layout(std430, set = 0, binding = 1) readonly buffer TargetsBuf { int targets[]; };
layout(std430, set = 0, binding = 2) writeonly buffer PartialBuf { float partial_loss[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint cols;
} p;

shared float scratch[64];

void main() {
    const uint row = gl_WorkGroupID.x;
    const uint lane = gl_LocalInvocationID.x;
    if (row >= p.rows) return;
    const uint base = row * p.cols;

    float maxv = -3.402823466e+38;
    for (uint c = lane; c < p.cols; c += 64u) {
        maxv = max(maxv, logits[base + c]);
    }
    scratch[lane] = maxv;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (lane < stride) scratch[lane] = max(scratch[lane], scratch[lane + stride]);
        barrier();
    }
    maxv = scratch[0];
    barrier();

    float sum = 0.0;
    for (uint c = lane; c < p.cols; c += 64u) {
        sum += exp(logits[base + c] - maxv);
    }
    scratch[lane] = sum;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (lane < stride) scratch[lane] += scratch[lane + stride];
        barrier();
    }

    if (lane == 0u) {
        const int target = targets[row];
        if (target < 0 || uint(target) >= p.cols) {
            partial_loss[row] = 0.0;
        } else {
            partial_loss[row] = log(scratch[0]) + maxv - logits[base + uint(target)];
        }
    }
}
