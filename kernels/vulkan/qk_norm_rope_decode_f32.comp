// Portable fused Q/K RMSNorm + RoPE for a single decode token.
#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer QBuf { float q[]; };
layout(std430, set = 0, binding = 1) readonly buffer KBuf { float k[]; };
layout(std430, set = 0, binding = 2) readonly buffer QWBuf { float qw[]; };
layout(std430, set = 0, binding = 3) readonly buffer KWBuf { float kw[]; };
layout(std430, set = 0, binding = 4) writeonly buffer QOutBuf { float qout[]; };
layout(std430, set = 0, binding = 5) writeonly buffer KOutBuf { float kout[]; };

layout(push_constant) uniform Push {
    uint batch;
    uint n_head;
    uint n_kv_head;
    uint head_dim;
    uint rotary_dim;
    uint token_offset;
    float theta;
    float q_eps;
    float k_eps;
} p;

shared float scratch[64];

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint group = gl_WorkGroupID.x;
    const uint heads_total = p.n_head + p.n_kv_head;
    const uint b = group / heads_total;
    const uint local_head = group - b * heads_total;
    if (b >= p.batch) return;
    const bool is_q = local_head < p.n_head;
    const uint head = is_q ? local_head : local_head - p.n_head;
    const uint channels = (is_q ? p.n_head : p.n_kv_head) * p.head_dim;
    const uint base = b * channels + head * p.head_dim;

    float ss = 0.0;
    for (uint d = lane; d < p.head_dim; d += 64u) {
        const float value = is_q ? q[base + d] : k[base + d];
        ss += value * value;
    }
    scratch[lane] = ss;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (lane < stride) scratch[lane] += scratch[lane + stride];
        barrier();
    }
    const float eps = is_q ? p.q_eps : p.k_eps;
    const float inv = inversesqrt(scratch[0] / float(p.head_dim) + eps);
    const uint rd = min(p.rotary_dim, p.head_dim) & ~1u;
    for (uint d = lane; d < p.head_dim; d += 64u) {
        float value;
        if (d >= rd) {
            value = (is_q ? q[base + d] * qw[d] : k[base + d] * kw[d]) * inv;
        } else {
            const uint pair_d = d & ~1u;
            const float angle = float(p.token_offset) /
                pow(p.theta, float(pair_d) / float(p.head_dim));
            const float cs = cos(angle);
            const float sn = sin(angle);
            const float even = (is_q ? q[base + pair_d] * qw[pair_d]
                                     : k[base + pair_d] * kw[pair_d]) * inv;
            const float odd = (is_q ? q[base + pair_d + 1u] * qw[pair_d + 1u]
                                    : k[base + pair_d + 1u] * kw[pair_d + 1u]) * inv;
            value = d == pair_d ? even * cs - odd * sn : even * sn + odd * cs;
        }
        if (is_q) qout[base + d] = value;
        else kout[base + d] = value;
    }
}
