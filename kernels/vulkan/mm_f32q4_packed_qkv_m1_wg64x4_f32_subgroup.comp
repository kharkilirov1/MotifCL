// Wave64 subgroup-optimized packed QKV Q4_0 decode matmul.
#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer ABuf { float A[]; };
layout(std430, set = 0, binding = 1) readonly buffer BBuf { uint8_t B[]; };
layout(std430, set = 0, binding = 2) readonly buffer SBuf { float S[]; };
layout(std430, set = 0, binding = 3) writeonly buffer QBuf { float Q[]; };
layout(std430, set = 0, binding = 4) writeonly buffer KBuf { float Kout[]; };
layout(std430, set = 0, binding = 5) writeonly buffer VBuf { float V[]; };

layout(push_constant) uniform Push {
    uint q_dim;
    uint kv_dim;
    uint in_dim;
} p;

float q4_load(uint idx) {
    const uint packed = uint(B[idx >> 1u]);
    const uint code = (idx & 1u) == 0u ? (packed & 15u) : ((packed >> 4u) & 15u);
    return float(int(code) - 8);
}

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint col0 = gl_WorkGroupID.x * 4u;
    const uint total = p.q_dim + 2u * p.kv_dim;
    float acc[4] = float[4](0.0, 0.0, 0.0, 0.0);
    for (uint kidx = lane; kidx < p.in_dim; kidx += 64u) {
        const float av = A[kidx];
        for (uint j = 0u; j < 4u; ++j) {
            const uint col = col0 + j;
            if (col < total) acc[j] += av * q4_load(kidx * total + col) * S[col];
        }
    }
    for (uint j = 0u; j < 4u; ++j) acc[j] = subgroupAdd(acc[j]);
    if (lane == 0u) {
        const uint qk_dim = p.q_dim + p.kv_dim;
        for (uint j = 0u; j < 4u; ++j) {
            const uint col = col0 + j;
            if (col >= total) continue;
            if (col < p.q_dim) Q[col] = acc[j];
            else if (col < qk_dim) Kout[col - p.q_dim] = acc[j];
            else V[col - qk_dim] = acc[j];
        }
    }
}
