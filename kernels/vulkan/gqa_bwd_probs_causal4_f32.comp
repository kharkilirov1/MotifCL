// Tiled causal grouped-query attention backward stage 1: probability recompute,
// softmax backward term `ds`, and dQ, for the training fast path.
//
// The general kernel runs one workgroup per (batch, head, query row) and streams
// the full K/V history per row; it measured 32 ms per training step (~5.4 ms per
// layer) and was the single largest attention cost. This specialization keeps
// ROWS=4 consecutive causal query rows in one workgroup:
//
//   * pass 1 recomputes the four score rows from one K load per key and takes a
//     `vec4` subgroup max;
//   * pass 2 normalizes the softmax numerators (vec4 subgroup sum);
//   * pass 3 computes dp = dout . v once per key for four rows, and the
//     `sum(dp*p)` row dot, again with a vec4 subgroup reduction;
//   * pass 4 emits `p`, `ds` and caches `ds` in shared memory;
//   * pass 5 forms dQ with one lane per output dimension, reusing each K element
//     across the four rows.
//
// Preconditions (checked by the caller, which otherwise keeps the general
// kernel): causal, no mask tensor, query_offset == 0, sliding_window == 0,
// key_stride == key_tokens == query_tokens <= 256, head_dim == v_head_dim <= 64.
#version 450

#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer QBuf { float q[]; };
layout(std430, set = 0, binding = 1) readonly buffer KBuf { float k[]; };
layout(std430, set = 0, binding = 2) readonly buffer VBuf { float v[]; };
layout(std430, set = 0, binding = 3) readonly buffer DoutBuf { float dout[]; };
layout(std430, set = 0, binding = 4) writeonly buffer PBuf { float p_out[]; };
layout(std430, set = 0, binding = 5) writeonly buffer DsBuf { float ds_out[]; };
layout(std430, set = 0, binding = 6) writeonly buffer DqBuf { float dq[]; };

layout(push_constant) uniform Push {
    uint batch;
    uint query_tokens;
    uint key_tokens;
    uint n_head;
    uint n_kv_head;
    uint head_dim;
    float scale;
} p;

#define ROWS 4
#define MAXK 256
#define MAXD 64

shared float qs[ROWS][MAXD];
shared float ds_in[ROWS][MAXD];
shared float probs[ROWS][MAXK];
shared float dps[ROWS][MAXK];

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint r0 = gl_WorkGroupID.x * uint(ROWS);
    const uint h = gl_WorkGroupID.y;
    const uint b = gl_WorkGroupID.z;
    const uint T = p.query_tokens;
    if (h >= p.n_head || b >= p.batch || r0 >= T) return;

    const uint group_size = p.n_head / p.n_kv_head;
    const uint kv_head = h / group_size;
    const uint q_channels = p.n_head * p.head_dim;
    const uint kv_channels = p.n_kv_head * p.head_dim;
    const float neg_inf = -3.402823466e+38;
    const uint key_hi = min(p.key_tokens, r0 + uint(ROWS));

    // Stage the four q and dout rows.
    for (uint j = 0u; j < uint(ROWS); ++j) {
        const uint tq = r0 + j;
        if (tq < T) {
            const uint qb = (b * T + tq) * q_channels + h * p.head_dim;
            for (uint d = lane; d < p.head_dim; d += 64u) {
                qs[j][d] = q[qb + d];
                ds_in[j][d] = dout[qb + d];
            }
        }
    }
    barrier();

    // Pass 1: scores (causal-masked) + vec4 subgroup max.
    vec4 lane_max = vec4(neg_inf);
    for (uint tk = lane; tk < key_hi; tk += 64u) {
        const uint kb = (b * p.key_tokens + tk) * kv_channels + kv_head * p.head_dim;
        float d0 = 0.0;
        float d1 = 0.0;
        float d2 = 0.0;
        float d3 = 0.0;
        for (uint d = 0u; d < p.head_dim; ++d) {
            const float kd = k[kb + d];
            d0 += qs[0][d] * kd;
            d1 += qs[1][d] * kd;
            d2 += qs[2][d] * kd;
            d3 += qs[3][d] * kd;
        }
        vec4 s = vec4(d0, d1, d2, d3) * p.scale;
        if (tk > r0 + 0u) s.x = neg_inf;
        if (tk > r0 + 1u) s.y = neg_inf;
        if (tk > r0 + 2u) s.z = neg_inf;
        probs[0][tk] = s.x;
        probs[1][tk] = s.y;
        probs[2][tk] = s.z;
        probs[3][tk] = s.w;
        lane_max = max(lane_max, s);
    }
    vec4 row_max = subgroupMax(lane_max);
    if (row_max.x == neg_inf) row_max.x = 0.0;
    if (row_max.y == neg_inf) row_max.y = 0.0;
    if (row_max.z == neg_inf) row_max.z = 0.0;
    if (row_max.w == neg_inf) row_max.w = 0.0;

    // Pass 2: unnormalized softmax numerators + vec4 subgroup sum.
    vec4 lane_sum = vec4(0.0);
    for (uint tk = lane; tk < key_hi; tk += 64u) {
        vec4 e;
        e.x = probs[0][tk] == neg_inf ? 0.0 : exp(probs[0][tk] - row_max.x);
        e.y = probs[1][tk] == neg_inf ? 0.0 : exp(probs[1][tk] - row_max.y);
        e.z = probs[2][tk] == neg_inf ? 0.0 : exp(probs[2][tk] - row_max.z);
        e.w = probs[3][tk] == neg_inf ? 0.0 : exp(probs[3][tk] - row_max.w);
        probs[0][tk] = e.x;
        probs[1][tk] = e.y;
        probs[2][tk] = e.z;
        probs[3][tk] = e.w;
        lane_sum += e;
    }
    vec4 sum = subgroupAdd(lane_sum);
    vec4 inv = vec4(sum.x > 0.0 ? 1.0 / sum.x : 0.0, sum.y > 0.0 ? 1.0 / sum.y : 0.0,
                    sum.z > 0.0 ? 1.0 / sum.z : 0.0, sum.w > 0.0 ? 1.0 / sum.w : 0.0);

    // Pass 3: dp = dout . v per key for the four rows, plus the sum(dp*p) row dot.
    vec4 lane_dot = vec4(0.0);
    for (uint tk = lane; tk < key_hi; tk += 64u) {
        const uint vb = (b * p.key_tokens + tk) * kv_channels + kv_head * p.head_dim;
        float e0 = 0.0;
        float e1 = 0.0;
        float e2 = 0.0;
        float e3 = 0.0;
        for (uint d = 0u; d < p.head_dim; ++d) {
            const float vd = v[vb + d];
            e0 += ds_in[0][d] * vd;
            e1 += ds_in[1][d] * vd;
            e2 += ds_in[2][d] * vd;
            e3 += ds_in[3][d] * vd;
        }
        dps[0][tk] = e0;
        dps[1][tk] = e1;
        dps[2][tk] = e2;
        dps[3][tk] = e3;
        lane_dot.x += e0 * probs[0][tk] * inv.x;
        lane_dot.y += e1 * probs[1][tk] * inv.y;
        lane_dot.z += e2 * probs[2][tk] * inv.z;
        lane_dot.w += e3 * probs[3][tk] * inv.w;
    }
    vec4 row_dot = subgroupAdd(lane_dot);
    barrier();

    // Pass 4: emit normalized probabilities and ds; cache ds for the dQ pass.
    const uint row_base = (b * p.n_head + h) * T * p.key_tokens + r0 * p.key_tokens;
    for (uint tk = lane; tk < p.key_tokens; tk += 64u) {
        vec4 pv = vec4(0.0);
        vec4 dv = vec4(0.0);
        if (tk < key_hi) {
            pv = vec4(probs[0][tk], probs[1][tk], probs[2][tk], probs[3][tk]) * inv;
            dv = vec4(pv.x * (dps[0][tk] - row_dot.x), pv.y * (dps[1][tk] - row_dot.y),
                      pv.z * (dps[2][tk] - row_dot.z), pv.w * (dps[3][tk] - row_dot.w));
        }
        const uint base = row_base + tk;
        if (r0 + 0u < T) p_out[base + 0u * p.key_tokens] = pv.x;
        if (r0 + 1u < T) p_out[base + 1u * p.key_tokens] = pv.y;
        if (r0 + 2u < T) p_out[base + 2u * p.key_tokens] = pv.z;
        if (r0 + 3u < T) p_out[base + 3u * p.key_tokens] = pv.w;
        if (r0 + 0u < T) ds_out[base + 0u * p.key_tokens] = dv.x;
        if (r0 + 1u < T) ds_out[base + 1u * p.key_tokens] = dv.y;
        if (r0 + 2u < T) ds_out[base + 2u * p.key_tokens] = dv.z;
        if (r0 + 3u < T) ds_out[base + 3u * p.key_tokens] = dv.w;
        dps[0][tk] = dv.x;
        dps[1][tk] = dv.y;
        dps[2][tk] = dv.z;
        dps[3][tk] = dv.w;
    }
    barrier();

    // Pass 5: dQ with one lane per output dimension, reusing each K element
    // across the four rows.
    if (lane < p.head_dim) {
        const uint d = lane;
        const uint kb = kv_head * p.head_dim + d;
        float a0 = 0.0;
        float a1 = 0.0;
        float a2 = 0.0;
        float a3 = 0.0;
        for (uint tk = 0u; tk < p.key_tokens; ++tk) {
            const float kd = k[(b * p.key_tokens + tk) * kv_channels + kb];
            a0 += dps[0][tk] * kd;
            a1 += dps[1][tk] * kd;
            a2 += dps[2][tk] * kd;
            a3 += dps[3][tk] * kd;
        }
        const uint qb = h * p.head_dim + d;
        if (r0 + 0u < T) dq[(b * T + r0 + 0u) * q_channels + qb] = a0 * p.scale;
        if (r0 + 1u < T) dq[(b * T + r0 + 1u) * q_channels + qb] = a1 * p.scale;
        if (r0 + 2u < T) dq[(b * T + r0 + 2u) * q_channels + qb] = a2 * p.scale;
        if (r0 + 3u < T) dq[(b * T + r0 + 3u) * q_channels + qb] = a3 * p.scale;
    }
}
